#!/bin/sh

# prjct CLI - Runtime-agnostic entry point
#
# Detects available runtime and executes the appropriate entry point.
# Defaults: node-first when installed via npm/pnpm/yarn (node_modules/.bin),
# bun-first only in dev/source checkouts or when PRJCT_RUNTIME=bun.
#
# CRITICAL: Also ensures p.md is installed (self-healing)
#
# @version 1.2.0

# Resolve symlinks to get the actual script location
resolve_symlink() {
  TARGET="$1"

  # Try readlink -f (Linux, newer macOS)
  if command -v readlink >/dev/null 2>&1; then
    RESOLVED="$(readlink -f "$TARGET" 2>/dev/null)"
    if [ -n "$RESOLVED" ]; then
      echo "$RESOLVED"
      return
    fi
  fi

  # Fallback: manual symlink resolution
  while [ -L "$TARGET" ]; do
    DIR="$(dirname "$TARGET")"
    TARGET="$(readlink "$TARGET")"
    # Handle relative symlinks
    case "$TARGET" in
      /*) ;;
      *) TARGET="$DIR/$TARGET" ;;
    esac
  done

  # Get absolute path
  DIR="$(cd "$(dirname "$TARGET")" && pwd)"
  echo "$DIR/$(basename "$TARGET")"
}

# Get the actual script location (resolving symlinks)
SCRIPT_PATH="$(resolve_symlink "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Stdio MCP entry point for `npx -y prjct-cli mcp-server`.
# Keep this before self-healing setup so MCP stdout stays protocol-only.
if [ "$1" = "mcp-server" ]; then
  MCP_SERVER="$ROOT_DIR/dist/mcp/server.mjs"
  if [ ! -f "$MCP_SERVER" ]; then
    echo "Error: MCP server entry point not found. Run 'npm run build' first." >&2
    exit 1
  fi
  NODE_VER="$(node -v 2>/dev/null | sed 's/^v//')"
  NODE_MAJ="${NODE_VER%%.*}"
  NODE_MIN_REST="${NODE_VER#*.}"
  NODE_MIN="${NODE_MIN_REST%%.*}"
  if [ "${NODE_MAJ:-0}" -lt 22 ] || { [ "${NODE_MAJ:-0}" -eq 22 ] && [ "${NODE_MIN:-0}" -lt 5 ]; }; then
    echo "Error: prjct MCP needs Node >=22.5 (for node:sqlite) — found Node ${NODE_VER:-unknown}." >&2
    exit 1
  fi
  export NODE_OPTIONS="--experimental-sqlite${NODE_OPTIONS:+ $NODE_OPTIONS}"
  exec node "$MCP_SERVER"
fi

# Ensure statusline and basic config (self-healing)
# Router (p.md) is deprecated — skills handle workflows natively
ensure_setup() {
  # Clean up legacy routers if they exist (deprecated — skills are native)
  for LEGACY_ROUTER in "$HOME/.claude/commands/p.md" "$HOME/.gemini/commands/p.toml"; do
    if [ -f "$LEGACY_ROUTER" ]; then
      rm -f "$LEGACY_ROUTER" 2>/dev/null
    fi
  done

  # Ensure statusline (best effort)
  STATUSLINE_SRC="$ROOT_DIR/assets/statusline/statusline.sh"
  STATUSLINE_DIR="$HOME/.prjct-cli/statusline"
  STATUSLINE_DEST="$STATUSLINE_DIR/statusline.sh"
  CLAUDE_STATUSLINE="$HOME/.claude/prjct-statusline.sh"

  if [ -f "$STATUSLINE_SRC" ]; then
    if [ ! -f "$STATUSLINE_DEST" ] || [ "$STATUSLINE_SRC" -nt "$STATUSLINE_DEST" ]; then
      mkdir -p "$STATUSLINE_DIR" 2>/dev/null
      cp "$STATUSLINE_SRC" "$STATUSLINE_DEST" 2>/dev/null
      chmod +x "$STATUSLINE_DEST" 2>/dev/null

      # Patch CLI_VERSION with actual version from package.json
      PKG_VERSION=$(grep '"version"' "$ROOT_DIR/package.json" 2>/dev/null | head -1 | sed 's/.*"version": *"\([^"]*\)".*/\1/')
      if [ -n "$PKG_VERSION" ]; then
        sed -i.bak "s/CLI_VERSION=\"[^\"]*\"/CLI_VERSION=\"$PKG_VERSION\"/" "$STATUSLINE_DEST" 2>/dev/null
        rm -f "$STATUSLINE_DEST.bak" 2>/dev/null
      fi

      # Copy lib, components, themes
      for subdir in lib components themes; do
        if [ -d "$ROOT_DIR/assets/statusline/$subdir" ]; then
          mkdir -p "$STATUSLINE_DIR/$subdir" 2>/dev/null
          cp "$ROOT_DIR/assets/statusline/$subdir"/* "$STATUSLINE_DIR/$subdir/" 2>/dev/null
        fi
      done

      # Symlink to ~/.claude
      mkdir -p "$(dirname "$CLAUDE_STATUSLINE")" 2>/dev/null
      rm -f "$CLAUDE_STATUSLINE" 2>/dev/null
      ln -s "$STATUSLINE_DEST" "$CLAUDE_STATUSLINE" 2>/dev/null || cp "$STATUSLINE_DEST" "$CLAUDE_STATUSLINE" 2>/dev/null
      chmod +x "$CLAUDE_STATUSLINE" 2>/dev/null
    fi
  fi

  # Ensure prjct skill is installed where Claude can see it.
  # postinstall is unreliable (--ignore-scripts, npm policies), so the
  # bin shim self-heals on every invocation. mtime-based: source newer
  # than dest → overwrite. Common case (skill up-to-date) = two stats.
  # Codex skill installation is handled by the TypeScript setup path, which
  # synthesizes the compact skill from editor-surfaces.ts rather than reading
  # a generated source-tree file.
  install_skill() {
    if [ -f "$1" ] && { [ ! -f "$2" ] || [ "$1" -nt "$2" ]; }; then
      mkdir -p "$(dirname "$2")" 2>/dev/null
      cp "$1" "$2" 2>/dev/null
    fi
  }
  install_skill "$ROOT_DIR/templates/skills/prjct/SKILL.md" "$HOME/.claude/skills/prjct/SKILL.md"
}

# Check if bun is available
check_bun() {
  command -v bun >/dev/null 2>&1
}

# Check if node is available
check_node() {
  command -v node >/dev/null 2>&1
}

# prjct uses node's built-in `node:sqlite`, which requires Node >=22.5.
# Returns 0 only when a node that new is on PATH. Sets NODE_VER as a side
# effect so callers can build an actionable error message.
node_supported() {
  check_node || return 1
  NODE_VER="$(node -v 2>/dev/null | sed 's/^v//')"
  NODE_MAJ="${NODE_VER%%.*}"
  NODE_MIN_REST="${NODE_VER#*.}"
  NODE_MIN="${NODE_MIN_REST%%.*}"
  if [ "${NODE_MAJ:-0}" -lt 22 ] || { [ "${NODE_MAJ:-0}" -eq 22 ] && [ "${NODE_MIN:-0}" -lt 5 ]; }; then
    return 1
  fi
  return 0
}

# Check if this shim was installed via npm/pnpm/yarn (node_modules/.bin).
# In that context the user already has Node and the package manager runtime;
# preferring bun breaks pnpm installs where bun is not present.
is_node_modules_install() {
  case "$SCRIPT_PATH" in
    */node_modules/*) return 0 ;;
  esac
  return 1
}

# Run with bun (compiled dist preferred, TypeScript only for explicit dev)
run_with_bun() {
  # Always prefer compiled dist — works for npm install, npm link, bun link
  if [ -f "$ROOT_DIR/dist/bin/prjct.mjs" ]; then
    # Explicit dev mode: PRJCT_DEV=1 forces raw TypeScript (faster iteration)
    if [ "$PRJCT_DEV" = "1" ] && [ -f "$SCRIPT_DIR/prjct.ts" ]; then
      exec bun "$SCRIPT_DIR/prjct.ts" "$@"
    fi
    exec bun "$ROOT_DIR/dist/bin/prjct.mjs" "$@"
  fi
  # No dist: fall back to raw TypeScript (first run before build)
  if [ -f "$SCRIPT_DIR/prjct.ts" ]; then
    exec bun "$SCRIPT_DIR/prjct.ts" "$@"
  fi
  echo "Error: No entry point found. Run 'npm run build' first."
  exit 1
}

# Run with node (compiled JavaScript)
run_with_node() {
  DIST_BIN="$ROOT_DIR/dist/bin/prjct.mjs"

  if [ ! -f "$DIST_BIN" ]; then
    # No dist: try to build if this looks like a dev checkout
    if [ -f "$ROOT_DIR/scripts/build.js" ] && [ -d "$ROOT_DIR/core" ]; then
      echo "Building for Node.js (first run)..."
      node "$ROOT_DIR/scripts/build.js" || {
        echo "Error: Build failed. Run 'npm run build' manually."
        exit 1
      }
    else
      echo "Error: Compiled output not found. Run 'npm run build' first."
      exit 1
    fi
  fi

  # prjct uses node's built-in `node:sqlite` (zero native deps, no postinstall),
  # which requires Node >=22.5. Below that — and since we no longer auto-install
  # Bun (MAL-2026-4647) — prjct can't run: fail with a clear, actionable message
  # instead of a cryptic `--experimental-sqlite` flag error.
  if ! node_supported; then
    echo "Error: prjct needs Node >=22.5 (for node:sqlite) or Bun — found Node ${NODE_VER:-unknown}."
    echo "  Upgrade Node (https://nodejs.org) or install Bun (https://bun.sh)."
    exit 1
  fi

  # On Node 22.5–23.x node:sqlite lives behind `--experimental-sqlite`; on Node
  # 24+ it's unflagged and the flag is a tolerated no-op. Exporting it (vs an
  # argv flag) means the daemon + any node child prjct spawns inherit it too.
  # Prepended so a user's existing NODE_OPTIONS is preserved.
  export NODE_OPTIONS="--experimental-sqlite${NODE_OPTIONS:+ $NODE_OPTIONS}"
  exec node "$DIST_BIN" "$@"
}

# Main execution
main() {
  # Native verb fast path: for a daemon-served READ verb, hand off to the
  # native client (no runtime boot, no ensure_setup) — it talks to the warm
  # daemon and exits with its code. Exit 89 = punt → fall through to the
  # runtime below. Additive: a missing binary or a down daemon just continues.
  if [ "$PRJCT_NO_DAEMON" != "1" ]; then
    case "$1" in
      work|search|guard|status|prime)
        # One fork for platform+arch (matches node's process.platform/arch labels).
        _label=""
        case "$(uname -sm)" in
          "Darwin arm64") _label="darwin-arm64" ;;
          "Darwin x86_64") _label="darwin-x64" ;;
          "Linux x86_64") _label="linux-x64" ;;
          "Linux aarch64" | "Linux arm64") _label="linux-arm64" ;;
        esac
        _native="$ROOT_DIR/dist/bin/hook-fast-${_label}"
        if [ -n "$_label" ] && [ -x "$_native" ]; then
          "$_native" verb "$@"
          _rc=$?
          [ "$_rc" = 89 ] || exit "$_rc"
        fi
        ;;
    esac
  fi

  # Hooks fire per prompt / tool call / turn inside Claude Code — the hot
  # path must not pay ensure_setup's stats/cp/sed on every event. The .cjs
  # bin already skips setup for `hook` (bin/prjct.cjs setupSkipCommands);
  # this keeps the POSIX shim consistent. Self-heal still runs on every
  # non-hook invocation, so a stale statusline/skill gets repaired at most
  # one manual command later.
  if [ "$1" != "hook" ]; then
    ensure_setup
  fi

  # Runtime selection, in order of precedence:
  # 1. PRJCT_RUNTIME env var (bun|node) for explicit override.
  # 2. Installed via npm/pnpm/yarn (node_modules/.bin) -> node first, because
  #    that package manager/runtime is what the user already has.
  # 3. Dev/source checkout -> bun first for faster iteration, if available.
  # 4. Fall back to whichever runtime is available.
  # We deliberately do NOT auto-install bun: fetching an unpinned
  # `curl | bash` installer at runtime is a supply-chain risk (it triggered the
  # MAL-2026-4647 false-positive).
  _runtime="${PRJCT_RUNTIME:-}"
  case "$_runtime" in
    bun)
      if check_bun; then
        run_with_bun "$@"
      fi
      echo "Error: PRJCT_RUNTIME=bun requested but bun is not installed." >&2
      exit 1
      ;;
    node)
      if check_node; then
        run_with_node "$@"
      fi
      echo "Error: PRJCT_RUNTIME=node requested but node is not installed." >&2
      exit 1
      ;;
    '') ;;
    *)
      echo "Error: PRJCT_RUNTIME must be 'bun' or 'node' (got '$_runtime')." >&2
      exit 1
      ;;
  esac

  if is_node_modules_install; then
    # Node first, but only a node that can actually run prjct. A too-old node
    # would exit 1 from run_with_node and never reach the bun fallback, so a
    # pnpm/npm install on Node <22.5 with bun present must still start.
    if node_supported; then
      run_with_node "$@"
    elif check_bun; then
      run_with_bun "$@"
    elif check_node; then
      # Node present but too old and no bun — run_with_node prints the
      # actionable version error.
      run_with_node "$@"
    fi
  else
    if check_bun; then
      run_with_bun "$@"
    elif check_node; then
      run_with_node "$@"
    fi
  fi

  echo "Error: Neither bun nor node is installed." >&2
  echo "" >&2
  echo "Please install one of:" >&2
  echo "  - Node.js >=22.5: https://nodejs.org" >&2
  echo "  - Bun: https://bun.sh" >&2
  exit 1
}

main "$@"
